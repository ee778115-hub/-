<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#EEF3F0"
    android:fillViewport="true"
    android:layoutDirection="rtl">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="16dp">

        <!-- Header Card -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:background="@drawable/card_bg"
            android:orientation="vertical"
            android:padding="16dp">

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="تحويل الرسائل البنكية (الإصدار 1.2)"
                android:textColor="#0F5132"
                android:textSize="20sp"
                android:textStyle="bold" />

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="4dp"
                android:text="يلتقط رسائل البنوك (حتى التي تصل باسم بدون رقم) ويرسلها تلقائياً إلى واتساب."
                android:textColor="#444444"
                android:textSize="13sp" />

            <com.google.android.material.switchmaterial.SwitchMaterial
                android:id="@+id/switchEnabled"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="12dp"
                android:text="تفعيل التحويل التلقائي"
                android:textColor="#111111"
                android:textSize="16sp"
                android:textStyle="bold" />

            <TextView
                android:id="@+id/tvPermissionsSummary"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp"
                android:background="#F1F7F4"
                android:padding="10dp"
                android:text="جاري فحص الصلاحيات..."
                android:textColor="#0F5132"
                android:textSize="13sp"
                android:textStyle="bold" />
        </LinearLayout>

        <!-- Settings Card -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="14dp"
            android:background="@drawable/card_bg"
            android:orientation="vertical"
            android:padding="16dp">

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="1. أسماء البنوك (كما تظهر بدون رقم — افصل بينها بفاصلة):"
                android:textColor="#111111"
                android:textSize="15sp"
                android:textStyle="bold" />

            <EditText
                android:id="@+id/etBankSenders"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp"
                android:background="@drawable/input_bg"
                android:gravity="top|start"
                android:hint="مثال: Alkuraimi, CACBank, Tadhamon, الكريمي, النجم, حوالة"
                android:inputType="textMultiLine"
                android:minLines="3"
                android:padding="12dp"
                android:textColor="#111111"
                android:textColorHint="#666666"
                android:textSize="15sp" />

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="16dp"
                android:text="2. جهة الإرسال في واتساب:"
                android:textColor="#111111"
                android:textSize="15sp"
                android:textStyle="bold" />

            <RadioGroup
                android:id="@+id/rgTargetType"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="6dp"
                android:orientation="horizontal">

                <RadioButton
                    android:id="@+id/rbNumber"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:checked="true"
                    android:text="رقم المحاسب"
                    android:textColor="#111111"
                    android:textSize="14sp" />

                <RadioButton
                    android:id="@+id/rbGroup"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:text="مجموعة واتساب"
                    android:textColor="#111111"
                    android:textSize="14sp" />
            </RadioGroup>

            <EditText
                android:id="@+id/etTargetValue"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp"
                android:background="@drawable/input_bg"
                android:hint="رقم بمفتاح الدولة (967778115328) أو اسم المجموعة بالضبط"
                android:inputType="text"
                android:padding="12dp"
                android:textColor="#111111"
                android:textColorHint="#666666"
                android:textSize="15sp" />

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="16dp"
                android:text="نسخة واتساب المستخدمة:"
                android:textColor="#111111"
                android:textSize="15sp"
                android:textStyle="bold" />

            <RadioGroup
                android:id="@+id/rgWhatsAppType"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="6dp"
                android:orientation="horizontal">

                <RadioButton
                    android:id="@+id/rbWhatsAppNormal"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:checked="true"
                    android:text="واتساب العادي"
                    android:textColor="#111111"
                    android:textSize="14sp" />

                <RadioButton
                    android:id="@+id/rbWhatsAppBusiness"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:text="واتساب أعمال"
                    android:textColor="#111111"
                    android:textSize="14sp" />
            </RadioGroup>

            <Button
                android:id="@+id/btnSave"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="16dp"
                android:backgroundTint="#0F5132"
                android:padding="12dp"
                android:text="حفظ الإعدادات"
                android:textColor="#FFFFFF"
                android:textSize="15sp"
                android:textStyle="bold" />

            <Button
                android:id="@+id/btnTest"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp"
                android:backgroundTint="#198754"
                android:padding="12dp"
                android:text="تجربة الإرسال إلى واتساب الآن"
                android:textColor="#FFFFFF"
                android:textSize="15sp"
                android:textStyle="bold" />
        </LinearLayout>

        <!-- Permissions Card -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="14dp"
            android:background="@drawable/card_bg"
            android:orientation="vertical"
            android:padding="16dp">

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="الصلاحيات المطلوبة (فعّلها مرة واحدة):"
                android:textColor="#111111"
                android:textSize="15sp"
                android:textStyle="bold" />

            <Button
                android:id="@+id/btnSmsPermission"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="10dp"
                android:backgroundTint="#374151"
                android:text="1. صلاحية قراءة رسائل البنوك (SMS)"
                android:textColor="#FFFFFF" />

            <Button
                android:id="@+id/btnAccessibility"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp"
                android:backgroundTint="#374151"
                android:text="2. تفعيل خدمة إمكانية الوصول للإرسال التلقائي"
                android:textColor="#FFFFFF" />

            <Button
                android:id="@+id/btnOverlay"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp"
                android:backgroundTint="#0D6EFD"
                android:text="3. صلاحية الظهور في الأعلى (لفتح واتساب من الخلفية)"
                android:textColor="#FFFFFF" />

            <Button
                android:id="@+id/btnBattery"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp"
                android:backgroundTint="#374151"
                android:text="4. استثناء التطبيق من توفير البطارية"
                android:textColor="#FFFFFF" />
        </LinearLayout>

        <!-- Status Log Card -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="14dp"
            android:layout_marginBottom="16dp"
            android:background="@drawable/card_bg"
            android:orientation="vertical"
            android:padding="14dp">

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="سجل الحالة المباشر:"
                android:textColor="#0F5132"
                android:textSize="14sp"
                android:textStyle="bold" />

            <TextView
                android:id="@+id/tvStatusLog"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="6dp"
                android:text="جاهز لاستقبال رسائل البنوك."
                android:textColor="#111111"
                android:textSize="13sp" />
        </LinearLayout>

    </LinearLayout>
</ScrollView>
